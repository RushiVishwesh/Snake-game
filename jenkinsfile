pipeline {
    agent any
    stages {
        stage('SCM Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'gitlab',
                    url: 'https://gitlab.com/RushiVishwesh/snake.git'
            }
        }

        stage('docker build') {
            steps {
                sh '''
                docker build -t vishweshrushi/snake-game:${BUILD_NUMBER} .
                docker tag vishweshrushi/snake-game:${BUILD_NUMBER} vishweshrushi/snake-game:latest
                '''
            }
        }

        stage('docker push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh '''
                    docker login -u $USER -p $PASS
                    docker push vishweshrushi/snake-game:${BUILD_NUMBER}
                    docker push vishweshrushi/snake-game:latest
                    '''
                }
            }
        }
    }
}